# ==============================================================================
# Penta-Assistant Production Configuration & Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Model AI Routing (Google Antigravity Engine)
# ------------------------------------------------------------------------------
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Alternative Cloud AI Providers (Optional)
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
# GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Local Offline Inference with Ollama (Optional)
# MODEL_PROVIDER=ollama
# MODEL_NAME=llama3.2
# OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Commercial Subscription & Stripe Billing Engine
# ------------------------------------------------------------------------------
# In production, replace sk_test_... with your live key sk_live_... from stripe.com
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForSandbox12345
STRIPE_PRICE_ID_PRO=price_1Q_penta_pro_monthly
STRIPE_PRICE_ID_TEAM=price_1Q_penta_team_monthly
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 3. Security & Admin Control Room
# ------------------------------------------------------------------------------
# Used to authorize admin operations: user promotion, coupon generation, telemetry
ADMIN_SECRET_KEY=penta_admin_secret_2026_replace_with_strong_token

# ------------------------------------------------------------------------------
# 4. Optional Cloud WebRTC & TURN Relays (For P2P NAT Traversal)
# ------------------------------------------------------------------------------
# METERED_DOMAIN=your_metered_domain.metered.ca
# METERED_API_KEY=your_metered_secret_api_key

# ------------------------------------------------------------------------------
# 5. Local Device Targeting (Optional)
# ------------------------------------------------------------------------------
# ANDROID_SERIAL=
