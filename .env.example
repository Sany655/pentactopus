# 1. Database (Supabase, Neon, Render, or Railway Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# 2. Stripe Live Payments (from dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 3. Vision AI Gateway
GEMINI_API_KEY=AIzaSy...

# 4. Optional: Direct Binary CDN / Release Overrides
RELEASE_DOWNLOAD_EXE_URL=https://github.com/Sany655/pentactopus/releases/latest/download/PentaAssistant-Setup.exe
RELEASE_DOWNLOAD_APK_URL=https://github.com/Sany655/pentactopus/releases/latest/download/PentaAssistant.apk