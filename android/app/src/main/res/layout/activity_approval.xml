<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review exact outbound message"
        android:textSize="20sp"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/recipientInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Exact visible WhatsApp recipient name or number"
        android:singleLine="true"
        android:saveEnabled="false"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/messageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Exact message text"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="3"
        android:saveEnabled="false"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/confirmExactPayload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approve one send to this recipient with exactly this text." />

    <Button
        android:id="@+id/enableAccessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable accessibility service" />

    <Button
        android:id="@+id/approveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approve exact send"
        android:layout_marginTop="16dp" />
</LinearLayout>
