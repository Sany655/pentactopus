{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/download/(.*)", "destination": "/api/index.py" },
    { "source": "/dashboard", "destination": "/api/index.py" },
    { "source": "/login", "destination": "/api/index.py" },
    { "source": "/register", "destination": "/api/index.py" },
    { "source": "/admin", "destination": "/api/index.py" },
    { "source": "/index.html", "destination": "/api/index.py" },
    { "source": "/", "destination": "/api/index.py" }
  ]
}
