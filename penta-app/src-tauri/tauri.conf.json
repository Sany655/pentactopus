{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PentaAssistant",
  "version": "2.7.0",
  "identifier": "com.penta.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pentactopus — Remote Control & AI Agent",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": [
      "binaries/penta_daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 270
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "deleteAppDataOnUninstall": true
      },
      "wix": {
        "bannerPath": null,
        "dialogImagePath": null
      }
    }
  }
}
